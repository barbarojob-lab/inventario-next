generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Modelo de Empresa (reemplaza User para sistema multi-tenant)
model Company {
  id              String     @id @default(uuid())
  name            String
  code            String     @unique // Código único de acceso: INV-ABC123
  email           String     @unique
  password        String
  isActive        Boolean    @default(false)
  activationToken String?
  activationExp   DateTime?  // Token expira en 48 horas
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  stores          Store[]
  employees       Employee[]
}

// Modelo de Tienda (pertenece a una empresa)
model Store {
  id        Int            @id @default(autoincrement())
  companyId String
  name      String
  location  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]
  closures  ShiftClosure[]
}

// Modelo de Producto (pertenece a una tienda)
model Product {
  id        Int        @id @default(autoincrement())
  storeId   Int
  code      String?
  name      String
  price     Float
  cost      Float      @default(0)
  qty       Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  sales     Sale[]
  waste     Waste[]
}

// Modelo de Empleado (pertenece a una empresa)
model Employee {
  id          Int            @id @default(autoincrement())
  companyId   String
  name        String
  paymentType String
  payment     Float
  daysWorked  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  closures    ShiftClosure[]
}

// Modelo de Desperdicio
model Waste {
  id        Int      @id @default(autoincrement())
  productId Int
  quantity  Int
  reason    String?
  date      DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Modelo de Venta
model Sale {
  id          Int      @id @default(autoincrement())
  productId   Int
  quantity    Int
  total       Float
  costUnit    Float    @default(0)
  profitTotal Float    @default(0)
  date        DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Modelo de Compra
model Purchase {
  id        Int      @id @default(autoincrement())
  productId Int
  quantity  Int
  costUnit  Float
  total     Float
  date      DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Modelo de Cierre de Turno
model ShiftClosure {
  id          Int      @id @default(autoincrement())
  storeId     Int
  employeeId  Int
  totalAmount Float
  date        DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}
