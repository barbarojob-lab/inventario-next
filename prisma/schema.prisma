generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id        Int            @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  products  Product[]
  closures  ShiftClosure[]
}

model Product {
  id        Int        @id @default(autoincrement())
  storeId   Int
  code      String?
  name      String
  price     Float
  cost      Float      @default(0)
  qty       Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  sales     Sale[]
  waste     Waste[]
}

model Employee {
  id          Int            @id @default(autoincrement())
  name        String
  paymentType String
  payment     Float
  daysWorked  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  closures    ShiftClosure[]
}

model Waste {
  id        Int      @id @default(autoincrement())
  productId Int
  quantity  Int
  reason    String?
  date      DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Sale {
  id          Int      @id @default(autoincrement())
  productId   Int
  quantity    Int
  total       Float
  costUnit    Float    @default(0)
  profitTotal Float    @default(0)
  date        DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Purchase {
  id        Int      @id @default(autoincrement())
  productId Int
  quantity  Int
  costUnit  Float
  total     Float
  date      DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ShiftClosure {
  id          Int      @id @default(autoincrement())
  storeId     Int
  employeeId  Int
  totalAmount Float
  date        DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}
