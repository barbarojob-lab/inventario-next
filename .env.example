# ==========================================
# CONFIGURACIÓN DEL PROYECTO - INVENTARIO NEXT
# ==========================================

# Base de datos (PostgreSQL local o MySQL en producción)
# Ejemplo PostgreSQL: postgresql://usuario:password@localhost:5432/inventario
# Ejemplo MySQL: mysql://usuario:password@localhost:3306/inventario
DATABASE_URL="postgresql://usuario:password@localhost:5432/inventario"

# ==========================================
# SEGURIDAD - AUTENTICACIÓN
# ==========================================

# Clave secreta para firmar tokens JWT
# IMPORTANTE: Genera una clave segura y mantenla en secreto
# Genera una clave aquí: https://generate-secret.vercel.app/ (256 bits)
# O usa: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="TU_JWT_SECRET_AQUI_MINIMO_64_CARACTERES"

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# CONFIGURACIÓN DE PRODUCCIÓN (Opcional)
# ==========================================

# Si usas NextAuth u otro sistema de auth:
# NEXTAUTH_SECRET="tu-nextauth-secret"
# NEXTAUTH_URL="https://tu-dominio.com"

# Si usas envío de correos:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-email@gmail.com
# MAIL_PASSWORD=tu-app-password
# MAIL_FROM="Inventario Next <noreply@tu-dominio.com>"
